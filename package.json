{
  "name": "@regadas/pi-acp",
  "version": "0.1.0",
  "description": "ACP adapter for pi coding agent",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "contributors": [
    "Filipe Regadas <oss@regadas.email>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/regadas/pi-acp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/regadas/pi-acp/issues"
  },
  "homepage": "https://github.com/regadas/pi-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke-acp.mjs",
    "eval:acp": "npm run build && node scripts/eval-acp-client.mjs",
    "eval:tck": "npm run build && node scripts/eval-acp-tck.mjs",
    "eval:subagents:completion": "npm run build && node scripts/eval-subagents-completion.mjs",
    "eval:subagents:cancel": "npm run build && node scripts/eval-subagents-cancel.mjs",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run validate",
    "prepublishOnly": "npm run validate"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  }
}
