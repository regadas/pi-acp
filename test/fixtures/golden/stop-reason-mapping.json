{
  "formatVersion": 1,
  "name": "stop-reason-mapping",
  "description": "done reason length maps to max_tokens at agent_settled; a fresh turn does not inherit the previous turn's length stop; only the latest done reason counts (length then stop is end_turn).",
  "session": {
    "sessionId": "s1",
    "cwd": "/fixture/cwd",
    "supportsTerminalOutputMeta": false
  },
  "steps": [
    { "op": "prompt", "promptId": "p1", "text": "one" },
    { "op": "pi_event", "event": { "type": "agent_start" } },
    {
      "op": "pi_event",
      "event": {
        "type": "message_update",
        "assistantMessageEvent": { "type": "done", "reason": "length", "message": {} }
      }
    },
    { "op": "pi_event", "event": { "type": "agent_settled" } },
    { "op": "prompt", "promptId": "p2", "text": "two" },
    { "op": "pi_event", "event": { "type": "agent_start" } },
    { "op": "pi_event", "event": { "type": "agent_settled" } },
    { "op": "prompt", "promptId": "p3", "text": "three" },
    { "op": "pi_event", "event": { "type": "agent_start" } },
    {
      "op": "pi_event",
      "event": {
        "type": "message_update",
        "assistantMessageEvent": { "type": "done", "reason": "length", "message": {} }
      }
    },
    {
      "op": "pi_event",
      "event": {
        "type": "message_update",
        "assistantMessageEvent": { "type": "done", "reason": "stop", "message": {} }
      }
    },
    { "op": "pi_event", "event": { "type": "agent_settled" } }
  ],
  "expected": {
    "pi": [
      { "kind": "prompt", "message": "one" },
      { "kind": "prompt", "message": "two" },
      { "kind": "prompt", "message": "three" }
    ],
    "acp": [
      {
        "kind": "session_update",
        "update": {
          "sessionUpdate": "session_info_update",
          "_meta": { "piAcp": { "queueDepth": 0, "running": true } }
        }
      },
      {
        "kind": "session_update",
        "update": {
          "sessionUpdate": "session_info_update",
          "_meta": { "piAcp": { "queueDepth": 0, "running": false } }
        }
      },
      { "kind": "stop", "promptId": "p1", "stopReason": "max_tokens" },
      {
        "kind": "session_update",
        "update": {
          "sessionUpdate": "session_info_update",
          "_meta": { "piAcp": { "queueDepth": 0, "running": true } }
        }
      },
      {
        "kind": "session_update",
        "update": {
          "sessionUpdate": "session_info_update",
          "_meta": { "piAcp": { "queueDepth": 0, "running": false } }
        }
      },
      { "kind": "stop", "promptId": "p2", "stopReason": "end_turn" },
      {
        "kind": "session_update",
        "update": {
          "sessionUpdate": "session_info_update",
          "_meta": { "piAcp": { "queueDepth": 0, "running": true } }
        }
      },
      {
        "kind": "session_update",
        "update": {
          "sessionUpdate": "session_info_update",
          "_meta": { "piAcp": { "queueDepth": 0, "running": false } }
        }
      },
      { "kind": "stop", "promptId": "p3", "stopReason": "end_turn" }
    ]
  }
}
